<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the database goes to the cloud backup and to a new phone
     during device transfer. Reminders are rebuilt from it on launch. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_flutter/" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_flutter/" />
    </device-transfer>
</data-extraction-rules>
